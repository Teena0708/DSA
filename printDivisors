#include<bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin>>n;
    vector<int>ls;
    for(int i=1;i*i<=n;i++){
        if(n%i==0){
            ls.push_back(i);
            if((n/i)!=i)ls.push_back(n/i);         //TC:  O(sqrt(n))
        }
    }
    sort(ls.begin(),ls.end());  // TC:- n factors*logn => O(nlogn)
    for(auto it :ls)cout<<it<<" ";   //TC:- O(n);
    
    return 0;
}    //TC is addition of above 3 